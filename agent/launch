#!/bin/bash
# Starts claude or codex the way Herdr's + menu does: with instructions.md added to the
# agent's own instructions, so they reach agents started from Herdr and nowhere else.
# usage: launch [--sandbox] claude|codex [args...]
set -euo pipefail
dir="$(cd "$(dirname "$0")" && pwd)"
wrap=()
if [ "${1:-}" = --sandbox ]; then wrap=("$dir/../sandbox/agent-sandbox"); shift; fi
program="$1"; shift

# Started outside a shell (hc run starts programs with Herdr core's PATH, a login one):
# tools your interactive shell adds, like node from fnm, would be missing, and the
# agent's node-based hooks fail. Take PATH from an interactive shell then (~0.6s).
if ! command -v node >/dev/null; then
  path="$("${SHELL:-/bin/zsh}" -lic 'printf "\n__PATH__%s" "$PATH"' </dev/null 2>/dev/null | sed -n 's/^__PATH__//p')"
  [ -n "$path" ] && export PATH="$path"
fi

case "$program" in
  # Herdr draws Kitty images, but answers Claude Code's check for them out of order
  # (the end-of-replies answer comes first), so Claude Code would turn pictures off.
  # And it can't load an image from a file path (Kitty's t=f: "unsupported medium"),
  # which the show-your-work plugin uses unless it thinks it's over SSH, where it sends
  # the image itself. So: "over SSH". Side effects: Claude Code prints URLs instead of
  # opening the browser, and the plugin mutes video sound. A real SSH session's stays.
  claude)
    export CLAUDE_CODE_FORCE_TERMINAL_IMAGES=1
    export SSH_CONNECTION="${SSH_CONNECTION:-127.0.0.1 0 127.0.0.1 0}"
    # The chat's hook (mods/chat/ask-hook.sh): permissions and questions as cards in the chat
    # when it shows this agent; else Claude asks in the terminal as usual. Only for agents
    # started here, so your own settings.json stays as it is. Claude takes one --settings, and
    # the chat passes its own (fast mode), so ours is merged into that.
    # And mods/chat/event-hook.sh: what the log can't say yet (compacting, the reply as it
    # streams, API errors) as live events for the chat. Async, so Claude never waits on it.
    hook="$(jq -nc --arg c "sh '$dir/../mods/chat/ask-hook.sh'" --arg e "sh '$dir/../mods/chat/event-hook.sh'" '{hooks: (
      {PermissionRequest: [{hooks: [{type: "command", command: $c, timeout: 1800}]}]}
      + ([("PreCompact", "PostCompact", "MessageDisplay", "StopFailure", "PostToolUseFailure", "PermissionDenied", "Stop", "UserPromptSubmit", "SessionEnd", "SubagentStart", "SubagentStop")
          | {(.): [{hooks: [{type: "command", command: $e, async: true}]}]}] | add)
      + {PostToolUse: [{matcher: "SubagentHandback", hooks: [{type: "command", command: $e, async: true}]}]})}')"
    args=() merged=""
    while [ $# -gt 0 ]; do
      if [ "$1" = --settings ] && [ $# -gt 1 ]; then
        v="$2"; [ -f "$v" ] && v="$(cat "$v")"
        args+=(--settings "$(jq -nc --argjson a "$v" --argjson b "$hook" '$a * $b')"); merged=1; shift 2; continue
      fi
      args+=("$1"); shift
    done
    [ -n "$merged" ] || args=(--settings "$hook" ${args[@]+"${args[@]}"})
    exec ${wrap[@]+"${wrap[@]}"} claude --append-system-prompt-file "$dir/instructions.md" ${args[@]+"${args[@]}"} ;;
  # Codex takes the text itself, as a TOML string (a JSON string is one). It runs through
  # codex-live: the same Codex, with its TUI on a private app-server for the chat's live
  # events and approval cards (Codex as before when that can't work).
  # In the sandbox, Codex can't save its folder-trust answer (config.toml stays read-only: its
  # hooks and notify run outside the sandbox), so the folder it starts in (-C/--cd, else here)
  # comes trusted for this run instead of asking. Herdr's sandbox is what confines it, as Codex
  # can't start its own inside it: that is off unless the arguments ask for one (a fork or
  # resume from the chat or the Resume menu wouldn't load otherwise).
  # A helper another agent started (its terminal has a parent) comes trusted too: that agent
  # already works in its folder, and nobody is there to answer the question.
  codex)
    trust=()
    helper=""
    [ -n "${HC_TERMINAL_ID:-}" ] && [ -n "$(hc get "$HC_TERMINAL_ID" --json 2>/dev/null | jq -r '.parent // empty' 2>/dev/null)" ] && helper=1
    if [ ${#wrap[@]} -gt 0 ] || [ -n "$helper" ]; then
      cwd="$PWD" prev="" own=""
      for a in "$@"; do
        case "$prev" in -C|--cd) cwd="$a" ;; -c|--config) case "$a" in sandbox_mode=*) own=1 ;; esac ;; esac
        case "$a" in -s|--sandbox|--sandbox=*|--dangerously-bypass-approvals-and-sandbox|--yolo) own=1 ;; esac
        prev="$a"
      done
      trust=(-c "projects={$(jq -n --arg d "$(cd "$cwd" 2>/dev/null && pwd -P || printf %s "$cwd")" '$d')={trust_level=\"trusted\"}}")
      [ ${#wrap[@]} -eq 0 ] || [ -n "$own" ] || set -- "$@" --sandbox danger-full-access
    fi
    exec ${wrap[@]+"${wrap[@]}"} "$dir/codex-live" codex -c "developer_instructions=$(jq -Rs . < "$dir/instructions.md")" ${trust[@]+"${trust[@]}"} "$@" ;;
  *) exec ${wrap[@]+"${wrap[@]}"} "$program" "$@" ;;
esac
