                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": { "mod": "changes-sandbox" },
                      "background": "background",
                      "border": { "width": 1, "color": "border" },
                      "radius": 10
                    },
                    {
                      "id": "graph",
                      "type": "block",
                      "content": { "mod": "git-graph" }
                    },
                    {
                      "id": "linear",
                      "type": "block",
                      "content": {
                        "mod": "linear"
                      }
                    },
                    {
                      "id": "subagents",
                      "type": "block",
                      "content": { "mod": "chat", "props": { "view": "subagents" } }
                    },
                    {
                      "id": "artifacts",
                      "type": "stack",
                      "children": [
                        {
                          "id": "artifacts-list",
                          "type": "block",
                          "content": {
                            "mod": "artifacts"
                          }
                        },
                        {
                          "id": "artifacts-view",
                          "type": "column",
                          "children": [
                            {
                              "id": "artifacts-view-head",
                              "type": "block",
                              "content": {
                                "mod": "artifacts",
                                "props": {
                                  "head": true
                                }
                              },
                              "size": {
                                "px": 42
                              }
                            },
                            {
                              "id": "artifacts-view-body",
                              "type": "block",
                              "content": {
                                "mod": "artifacts"
                              }
                            }
                          ],
                          "background": "background",
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "radius": 10,
                          "resizable": false
                        }
                      ],
                      "active": "artifacts-list"
