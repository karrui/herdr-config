#!/bin/bash
# Restarts the Claude or Codex agent in Herdr terminal $1 with the sandbox "on" or "off" ($2),
# resuming the same conversation and keeping its other flags.
set -euo pipefail
term="$1"; mode="$2"
dir="$(cd "$(dirname "$0")" && pwd)"
usage="$(dirname "$dir")/usage"
fail() { echo "$1" >&2; exit 1; }
[ "$mode" != on ] || [ "$(uname -s)" = Darwin ] || fail "Herdr's filesystem sandbox is only available on macOS."

info=$(hc get "$term" --json)
chat=$(jq -r '.labels["herdr.chat"] // empty' <<<"$info")
shell_pid=$(jq -r '.pid' <<<"$info")
fg_pid=$(jq -r '.foreground.pid // empty' <<<"$info")
[ -n "$fg_pid" ] || fail "The agent isn't running."
in_shell=0
case "$(jq -r '.argv[0] | split("/") | last' <<<"$info")" in
  zsh|bash|fish|sh|-zsh|-bash|-fish|-sh) if [ "$fg_pid" != "$shell_pid" ]; then in_shell=1; fi ;;
esac
[ "$in_shell" = 1 ] || [ -n "$chat" ] || fail "This agent isn't running in a shell or attached to a chat."
app=$(jq -r '.status.app // empty' <<<"$info")
case "$app" in
  claude-code) program=claude ;;
  codex) program=codex ;;
  *) fail "Only Claude and Codex agents can be restarted." ;;
esac
# Its arguments after the program, minus how it was resumed, sandboxed and given
# Herdr's instructions (the launcher adds those back, read fresh).
args=()
while IFS= read -r -d '' a; do args+=("$a"); done < <(jq -j '.foreground.argv[] + "\u0000"' <<<"$info")
# They start after the program itself, which may run behind agent-sandbox or agent/codex-live.
start=1
for ((i = 0; i < ${#args[@]}; i++)); do [ "${args[$i]##*/}" = "$program" ] && { start=$((i + 1)); break; }; done
flags=()
rest=("${args[@]:$start}")
for ((i = 0; i < ${#rest[@]}; i++)); do
  a="${rest[$i]}"
  case "$program:$a" in
    claude:--resume|claude:-r|claude:--session-id|claude:--append-system-prompt-file|codex:--sandbox|codex:-s) i=$((i + 1)) ;;
    # Launch's own hooks (the chat's cards and live events) come back with it: kept, the line
    # typed into the shell grows past what a terminal line takes and arrives cut off.
    claude:--settings)
      v=$(jq -c '(.hooks // {}) |= with_entries(.value |= map(select(tostring | test("mods/chat/(ask|event)-hook\\.sh") | not)) | select(.value | length > 0))
        | if .hooks == {} then del(.hooks) else . end' <<<"${rest[$((i + 1))]:-}" 2>/dev/null || printf '%s' "${rest[$((i + 1))]:-}")
      [ "$v" = "{}" ] || flags+=("$a" "$v")
      i=$((i + 1)) ;;
    claude:--continue|claude:-c|codex:resume|codex:--last|codex:--dangerously-bypass-approvals-and-sandbox) ;;
    codex:-c) if [[ "${rest[$((i + 1))]:-}" == developer_instructions=* ]]; then i=$((i + 1)); else flags+=("$a"); fi ;;
    codex:*-*-*-*-*) [[ "$a" =~ ^[0-9a-f-]{36}$ ]] || flags+=("$a") ;;
    *) flags+=("$a") ;;
  esac
done

if [ "$program" = claude ]; then
  session=$(jq -r '.session // empty' "$usage/claude/$term.json" 2>/dev/null || true)
  cmd=(claude "${flags[@]+"${flags[@]}"}")
  # The status line names a session before its first message; only a saved one resumes.
  if [ -n "$session" ] && compgen -G "$HOME/.claude/projects/*/$session.jsonl" >/dev/null; then cmd+=(--resume "$session"); fi
else
  session=$("$usage/codex-usage" "$shell_pid" | jq -r '.session // empty')
  # Codex's own sandbox can't start inside ours; ours stands in for it.
  [ "$mode" = on ] && flags+=(--sandbox danger-full-access)
  if [ -n "$session" ]; then cmd=(codex resume "${flags[@]+"${flags[@]}"}" "$session"); else cmd=(codex "${flags[@]+"${flags[@]}"}"); fi
fi
if [ "$in_shell" = 0 ]; then
  [ -n "$session" ] || fail "The conversation isn't saved yet; send its first message before restarting."
  argv=$(printf '%s\0' "${cmd[@]}" | jq -Rs 'split("\u0000")[:-1]')
  HERDR_RESTART_CHAT="$chat" HERDR_RESTART_RESUME=1 HERDR_RESTART_SANDBOX="$mode" \
    bash "$(dirname "$dir")/mods/chat/restart.sh" "$term" "$argv" >/dev/null
  exit
fi
launch=("$(dirname "$dir")/agent/launch")
[ "$mode" = on ] && launch+=(--sandbox)
cmd=("${launch[@]}" "${cmd[@]}")

# Stop it (the whole foreground job, so the sandbox launcher cleans up too) and wait
# for the shell to come back: 10 s, then forcefully.
pgid=$(ps -o pgid= -p "$fg_pid" | tr -d ' ')
kill -TERM -- "-$pgid" 2>/dev/null || true
for i in $(seq 1 50); do
  pgrep -g "$pgid" >/dev/null || break
  [ "$i" = 50 ] && kill -KILL -- "-$pgid" 2>/dev/null || true
  sleep 0.2
done
sleep 0.3

# Sent from inside a Herdr terminal, hc would wrap the text in <hc from=...> tags for agents.
env -u HC_TERMINAL_ID -u HC_SCOPE hc send "$term" "$(printf '%q ' "${cmd[@]}")" >/dev/null
